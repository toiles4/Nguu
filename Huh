-- ESP STARDUST ORB
--==================================================

local StardustColor =
    Color3.fromRGB(255, 255, 0)

local StardustEnabled = false

local function GetStardustFolder()

    local Misc =
        workspace:FindFirstChild("Misc")

    return Misc
        and Misc:FindFirstChild(
            "DragonSphereSpawns"
        )
end

local function RemoveStardustESP()

    local Folder =
        GetStardustFolder()

    if not Folder then
        return
    end

    for _, Object in ipairs(
        Folder:GetDescendants()
    ) do

        local ESP =
            Object:FindFirstChild("StardustESP")

        if ESP then
            ESP:Destroy()
        end
    end
end

local function MakeStardustESP(Object)

    if not StardustEnabled then
        return
    end

    local Part

    if Object:IsA("BasePart") then
        Part = Object

    elseif Object:IsA("Model") then
        Part =
            Object.PrimaryPart
            or Object:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end

    if not Part then
        return
    end

    -- Phải có Mesh
    local Mesh =
        Part:FindFirstChildWhichIsA(
            "SpecialMesh",
            true
        )
        or Part:FindFirstChildWhichIsA(
            "Mesh",
            true
        )

    if not Mesh then
        return
    end

    if Part:FindFirstChild("StardustESP") then
        return
    end

    local Highlight =
        Instance.new("Highlight")

    Highlight.Name = "StardustESP"
    Highlight.Adornee = Part
    Highlight.FillColor = StardustColor
    Highlight.OutlineColor = StardustColor
    Highlight.FillTransparency = 0.45
    Highlight.OutlineTransparency = 0

    Highlight.Parent = Part
end

ESPBox:AddToggle("ESPStardustOrbNew", {
    Text = "ESP Stardust Orb",
    Default = false,

    Callback = function(Value)

        StardustEnabled = Value

        if not Value then
            RemoveStardustESP()
            return
        end

        task.spawn(function()

            while StardustEnabled
                and Library.Toggles.ESPStardustOrbNew.Value do

                local Folder =
                    GetStardustFolder()

                if Folder then

                    for _, Object in ipairs(
                        Folder:GetDescendants()
                    ) do
                        MakeStardustESP(Object)
                    end
                end

                task.wait(1)
            end
        end)
    end,
})

