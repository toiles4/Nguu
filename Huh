--==================================================
-- DUNGEON CLEAR COUNTER
--==================================================

local ClearCount = 0
local TrackedMobs = {}

local EventMobs =
    workspace
    :WaitForChild("World Mobs")
    :WaitForChild("Event Mobs")

local ClearLabel =
    NotifyBox:AddLabel("Dungeon Clear: 0")

local function UpdateClearLabel()

    pcall(function()
        ClearLabel:SetText(
            "Dungeon Clear: "
            .. tostring(ClearCount)
        )
    end)
end

local function TrackMob(Mob)

    if TrackedMobs[Mob] then
        return
    end

    local Humanoid =
        GetHumanoid(Mob)

    if not Humanoid then
        return
    end

    TrackedMobs[Mob] = true

    local ReachedZero = false

    task.spawn(function()

        while Mob.Parent do

            if Humanoid.Health <= 0 then
                ReachedZero = true
            end

            task.wait(0.05)
        end

        if ReachedZero then

            ClearCount += 1
            UpdateClearLabel()

            Library:Notify({
                Title = "Dungeon Clear",
                Description =
                    "Clear #"
                    .. tostring(ClearCount),
                Time = 2
            })
        end

        TrackedMobs[Mob] = nil
    end)
end

for _, Mob in ipairs(
    EventMobs:GetChildren()
) do
    TrackMob(Mob)
end

EventMobs.ChildAdded:Connect(function(Mob)
    TrackMob(Mob)
end)

