local ZajaMode = "Tween"
local ZajaRunning = false
local CurrentZajaTween

CollectionBox:AddDropdown("ZajaMode", {
    Values = {
        "Tween",
        "Teleport",
    },

    Default = "Tween",
    Multi = false,
    Text = "Mode",

    Callback = function(Value)
        ZajaMode = Value
    end,
})

local function FindArenaParts()

    local Result = {}

    local WorldMap =
        workspace:FindFirstChild("World Map")

    local SecretBossArea =
        WorldMap
        and WorldMap:FindFirstChild("SecretBossArea")

    if not SecretBossArea then
        return Result
    end

    for _, Object in ipairs(
        SecretBossArea:GetDescendants()
    ) do

        if string.find(
            string.lower(Object.Name),
            "arena"
        ) then

            local Part

            if Object:IsA("BasePart") then
                Part = Object

            elseif Object:IsA("Model") then
                Part =
                    Object.PrimaryPart
                    or Object:FindFirstChildWhichIsA(
                        "BasePart",
                        true
                    )
            end

            if Part then
                table.insert(Result, Part)
            end
        end
    end

    return Result
end

local function BossExists()

    local WorldMobs =
        workspace:FindFirstChild("World Mobs")

    local EventMobs =
        WorldMobs
        and WorldMobs:FindFirstChild("Event Mobs")

    if not EventMobs then
        return false
    end

    return
        EventMobs:FindFirstChild("Zaja") ~= nil
        or EventMobs:FindFirstChild("Destroyer") ~= nil
        or EventMobs:FindFirstChild("Destorys") ~= nil
end

local function MoveToArena(Arena)

    local Root = GetRoot()

    if not Root or not Arena then
        return
    end

    local Target =
        Arena.CFrame + Vector3.new(0, 3, 0)

    if ZajaMode == "Teleport" then

        Root.CFrame = Target

    else

        local Distance =
            (Arena.Position - Root.Position).Magnitude

        local Time =
            math.max(Distance / 300, 0.05)

        CurrentZajaTween =
            TweenService:Create(
                Root,
                TweenInfo.new(
                    Time,
                    Enum.EasingStyle.Linear
                ),
                {
                    CFrame = Target
                }
            )

        CurrentZajaTween:Play()
        CurrentZajaTween.Completed:Wait()

        CurrentZajaTween = nil
    end
end

CollectionBox:AddToggle("ZajaDestroyCollection", {
    Text = "Zaja Destorys [Collection]",
    Default = false,

    Callback = function(Value)

        ZajaRunning = Value

        if not Value then

            if CurrentZajaTween then
                pcall(function()
                    CurrentZajaTween:Cancel()
                end)

                CurrentZajaTween = nil
            end

            return
        end

        task.spawn(function()

            while ZajaRunning
                and Library.Toggles.ZajaDestroyCollection.Value do

                -- Zaja / Destroyer xuất hiện
                -- => DỪNG di chuyển
                if BossExists() then
                    task.wait(1)
                    continue
                end

                local Arenas =
                    FindArenaParts()

                for _, Arena in ipairs(Arenas) do

                    if not Library.Toggles.ZajaDestroyCollection.Value then
                        break
                    end

                    -- Boss xuất hiện giữa chừng
                    if BossExists() then
                        break
                    end

                    MoveToArena(Arena)

                    -- 10 giây mới chuyển Arena tiếp
                    task.wait(10)
                end

                task.wait(0.2)
            end
        end)
    end,
})

