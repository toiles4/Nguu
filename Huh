local HPMode = "Number"
local HPEnabled = false

NotifyBox:AddDropdown("HPModeNew", {
    Values = {
        "%",
        "Number",
    },

    Default = "Number",
    Multi = false,
    Text = "HP Display",

    Callback = function(Value)
        HPMode = Value
    end,
})

local function CreateHPESP(Model)

    if Model == LocalPlayer.Character then
        return
    end

    local Humanoid =
        GetHumanoid(Model)

    local Root =
        GetRootPart(Model)

    if not Humanoid or not Root then
        return
    end

    local Billboard =
        Root:FindFirstChild("HPESP_New")

    if not Billboard then

        Billboard =
            Instance.new("BillboardGui")

        Billboard.Name = "HPESP_New"
        Billboard.Adornee = Root
        Billboard.Size =
            UDim2.new(0, 160, 0, 35)

        Billboard.StudsOffset =
            Vector3.new(0, 4, 0)

        Billboard.AlwaysOnTop = true

        local Label =
            Instance.new("TextLabel")

        Label.Name = "HPLabel"
        Label.Size =
            UDim2.fromScale(1, 1)

        Label.BackgroundTransparency = 1
        Label.TextStrokeTransparency = 0
        Label.TextSize = 16

        Label.Parent = Billboard
        Billboard.Parent = Root
    end

    local Label =
        Billboard:FindFirstChild("HPLabel")

    if not Label then
        return
    end

    if HPMode == "%" then

        local Percent = 0

        if Humanoid.MaxHealth > 0 then
            Percent =
                math.floor(
                    Humanoid.Health
                    / Humanoid.MaxHealth
                    * 100
                )
        end

        Label.Text =
            "HP: " .. Percent .. "%"

    else

        Label.Text =
            "HP: "
            .. math.floor(Humanoid.Health)
            .. " / "
            .. math.floor(Humanoid.MaxHealth)
    end
end

